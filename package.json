{
  "name": "dc-franchise-db",
  "version": "1.0.0",
  "description": "A fan-made Total Drama franchise database tracking 9 seasons, 102 unique players, and 128 episodes. Includes player profiles, season history, voting analytics, rankings, and AI-powered episode/season generation.",
  "main": "config.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sim": "vitest run --config vitest.sim.config.js --reporter=verbose",
    "test:nightly": "node scripts/nightly-gate.mjs",
    "calibrate:voting": "vitest run tests/emotional-defection-calibration.test.js --reporter=verbose",
    "audit:realism": "vitest run --config vitest.audit.config.js tests/voting-realism-audit.test.js --reporter=verbose",
    "audit:season": "vitest run --config vitest.audit.config.js tests/full-season-audit.test.js --reporter=verbose",
    "audit:continuity": "vitest run --config vitest.audit.config.js tests/season-continuity-audit.test.js --reporter=verbose",
    "audit:events": "vitest run --config vitest.audit.config.js tests/event-rates-audit.test.js --reporter=verbose",
    "audit:social": "vitest run --config vitest.audit.config.js tests/social-repetition-audit.test.js --reporter=verbose",
    "audit:social-status": "vitest run --config vitest.audit.config.js tests/social-status-audit.test.js --reporter=verbose",
    "audit:bb-comps": "vitest run --config vitest.audit.config.js tests/bb-comp-domination-audit.test.js --reporter=verbose",
    "audit:tr-castle": "vitest run --config vitest.audit.config.js tests/tr-castle-audit.test.js --reporter=verbose",
    "audit:dr-balance": "vitest run --config vitest.audit.config.js tests/dr-balance-audit.test.js --reporter=verbose",
    "audit:all": "vitest run --config vitest.audit.config.js --reporter=verbose",
    "test:e2e": "playwright test",
    "test:show-pages": "vitest run --config vitest.browser.config.js tests/show-pages.e2e.test.js",
    "test:all": "vitest run && playwright test",
    "deploy": "wrangler deploy --config worker/wrangler.toml",
    "deploy:analytics": "wrangler deploy --config worker/wrangler-analytics.toml",
    "deploy:seasons": "wrangler deploy --config worker/wrangler-season.toml",
    "deploy:all": "npm run deploy && npm run deploy:analytics && npm run deploy:seasons",
    "preview": "wrangler dev --config worker/wrangler.toml",
    "build:favorites-context": "node scripts/build-favorites-context.mjs",
    "fix:social-counts": "node scripts/fix-social-counts.mjs",
    "avatars:check": "node tools/gen-avatar-manifest.mjs --check",
    "avatars:files": "node tools/gen-avatar-manifest.mjs --write-files --check",
    "d1:exec": "wrangler d1 execute dc-franchise --config worker/wrangler.toml --remote --file",
    "d1:migrate:portraits": "wrangler d1 execute dc-franchise --config worker/wrangler.toml --remote --file worker/live_season_migration_portrait.sql"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yannari/dc-franchise-db.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Yannari/dc-franchise-db/issues"
  },
  "homepage": "https://github.com/Yannari/dc-franchise-db#readme",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "jsdom": "^29.0.2",
    "playwright": "^1.59.1",
    "vitest": "^4.1.4",
    "wrangler": "^4.120.0"
  },
  "engines": {
    "node": ">=24"
  }
}
