# IDE
.vs/

# Claude Code local settings
.claude/settings.local.json

# Git worktrees
.worktrees/

# Superpowers SDD scratch (progress ledgers, etc.)
.superpowers/

# Playwright test artifacts
.playwright-mcp/
test-results/
playwright-report/

# Dependencies
node_modules/

# Test screenshots
*-test-*.png

# Uncompressed audio — convert to .mp3 before committing (keeps the repo lean)
assets/audio/*.wav

# Local D1 state. `wrangler dev --local` and `d1 execute --local` write a whole
# SQLite database in here; it is scratch, it is large, and committing it would put
# a stale copy of the franchise into the repo.
.wrangler/
worker/.wrangler/

# Subagent-driven development scratch: ledgers, briefs, reports, review packages.
.superpowers/

# Database backups. The production runbook tells an operator to `wrangler d1 export`
# before migrating, which writes a full logical dump of the franchise into the
# checkout — and the very next step tells them to push to main. Without this, one
# routine `git add -A` publishes the entire database to a public repo, permanently.
backups/
*.dump.sql

# The gallery lives in Cloudflare R2 (bucket dc-gallery), not here — 592 MB of
# it broke GitHub Pages, whose published-site limit is 1 GB. Kept on disk so
# localhost still works; pushed with scripts/upload_gallery_r2.py.
assets/gallery/
